# 默认：所有文本文件统一用 LF；二进制文件自动识别，不做换行转换
* text=auto eol=lf

# .gitattributes 自身
.gitattributes text eol=lf

# 无扩展名或特殊文件名
.gitignore text eol=lf
LICENSE text eol=lf

# Markdown 文档
*.md text eol=lf

# 前端文件
*.html text eol=lf
*.css text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf

# Rust / Tauri
*.rs text eol=lf
*.toml text eol=lf

# Python 脚本
*.py text eol=lf

# 未来可能出现的 Windows 脚本：保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 未来可能出现的 Unix shell 脚本：必须 LF
*.sh text eol=lf

# 常见二进制文件，明确标记，避免被当文本处理
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
